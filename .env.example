# Swarm CI environment — copy to .env and fill in. NEVER commit .env.
# The binary reads plain environment variables; load with: set -a; source .env; set +a

# Which LLM drives the planner/implementer: groq | google | anthropic | mock
LLM_PROVIDER=groq

# Primary inference via Groq Cloud (OpenAI-compatible):
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Backup / heavy reasoning — automatically used as fallback when present:
GOOGLE_API_KEY=your_google_ai_studio_key
GOOGLE_MODEL=gemini-3.6-flash

# Alternative primary (instead of groq):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Reserved for diff/page fetching (later phase):
# JINA_API_KEY=jina_...

# Runtime tuning (defaults fine for the demo):
# SWARM_BIND=127.0.0.1:3000
# Real-agent mode executes submitted repository code on this machine.
# Only on an isolated development machine with disposable credentials:
# SWARM_ALLOW_UNSANDBOXED_AGENT=I_UNDERSTAND_HOST_EXECUTION
# Required for real-agent task submission and worker-kill requests.
# Generate a fresh random token, e.g. `openssl rand -hex 32`, and keep it out of git.
# SWARM_API_TOKEN=
# SWARM_HEARTBEAT_MS=500
# SWARM_LEASE_TIMEOUT_MS=1500
# SWARM_REAP_INTERVAL_MS=250
# SWARM_MAX_ATTEMPTS=3
# SWARM_SIM_WORK_MS=3000
# SWARM_FIXTURE_DIR=fixtures/demo-pr
# Demo-only: artificial pause before planning, widens the live-kill window:
# SWARM_PLAN_DELAY_MS=4000
